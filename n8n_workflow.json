{
  "name": "India Inflation Forecasting & Monitoring Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "months",
              "value": 1
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Monthly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "command": "python c:\\Users\\mayan\\OneDrive\\Desktop\\inflation\\ analyzer\\ and\\ prediction\\src\\forecast.py"
      },
      "id": "node-exec-pipeline",
      "name": "Execute ML Pipeline",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "filePath": "c:\\Users\\mayan\\OneDrive\\Desktop\\inflation\\ analyzer\\ and\\ prediction\\data\\forecasts\\future_forecasts.csv"
      },
      "id": "node-read-forecast-file",
      "name": "Read Future Forecasts",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "toRead",
        "options": {
          "headerRow": true
        }
      },
      "id": "node-parse-csv",
      "name": "Parse Forecast CSV",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract the immediate next month's forecast and determine the winner model\nconst forecasts = items.map(item => item.json);\nif (forecasts.length === 0) return [];\n\nconst nextMonth = forecasts[0];\n// Assume we alert on the selected optimal model (e.g. XGBoost forecast)\nconst xgbForecast = parseFloat(nextMonth.XGB_Forecast);\nconst sarimaForecast = parseFloat(nextMonth.SARIMA_Forecast);\nconst targetDate = nextMonth.Date;\n\nreturn [{\n  json: {\n    targetDate,\n    xgbForecast,\n    sarimaForecast,\n    xgbUpper: parseFloat(nextMonth.XGB_Upper),\n    xgbLower: parseFloat(nextMonth.XGB_Lower),\n    isAlert: xgbForecast > 6.0 || xgbForecast < 2.0\n  }\n}];"
      },
      "id": "node-extract-next-month",
      "name": "Extract Next Month Forecast",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isAlert }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-threshold",
      "name": "Is Forecast Out of Comfort Zone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "channel": "#inflation-alerts",
        "text": "=:warning: **WARNING: India Inflation Alert** :warning:\nThe forecasted YoY CPI Inflation for *{{ $json.targetDate }}* is **{{ $json.xgbForecast.toFixed(2) }}%** (XGBoost) and **{{ $json.sarimaForecast.toFixed(2) }}%** (SARIMA).\nThis falls outside the RBI's comfort band of 2.0% - 6.0%.\n- **Prediction Interval**: [{{ $json.xgbLower.toFixed(2) }}%, {{ $json.xgbUpper.toFixed(2) }}%]\nPlease check the Streamlit dashboard for details."
      },
      "id": "node-slack-alert-true",
      "name": "Send Slack Warning Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1450,
        200
      ]
    },
    {
      "parameters": {
        "channel": "#inflation-alerts",
        "text": "=:white_check_mark: **INFO: India Inflation Forecast Normal** :white_check_mark:\nThe forecasted YoY CPI Inflation for *{{ $json.targetDate }}* is **{{ $json.xgbForecast.toFixed(2) }}%** (XGBoost) and **{{ $json.sarimaForecast.toFixed(2) }}%** (SARIMA).\nThis is within the RBI's comfortable target band of 2.0% - 6.0%.\n- **Prediction Interval**: [{{ $json.xgbLower.toFixed(2) }}%, {{ $json.xgbUpper.toFixed(2) }}%]"
      },
      "id": "node-slack-alert-false",
      "name": "Send Slack Standard Update",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1450,
        400
      ]
    }
  ],
  "connections": {
    "Monthly Schedule Trigger": {
      "main": [
        [
          {
            "node": "Execute ML Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute ML Pipeline": {
      "main": [
        [
          {
            "node": "Read Future Forecasts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Future Forecasts": {
      "main": [
        [
          {
            "node": "Parse Forecast CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Forecast CSV": {
      "main": [
        [
          {
            "node": "Extract Next Month Forecast",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Next Month Forecast": {
      "main": [
        [
          {
            "node": "Is Forecast Out of Comfort Zone?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Forecast Out of Comfort Zone?": {
      "main": [
        [
          {
            "node": "Send Slack Warning Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Slack Standard Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionTimeout": 3600,
    "saveManualExecutions": true
  }
}
